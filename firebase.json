{
  "hosting": {
    "public": "salma",
    "ignore": [
      "LEEME.md",
      "**/.*",
      "fonts/LICENSE-*"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "**/*.@(webp|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "trailingSlash": false,
    "redirects": [
      {
        "source": "/salma",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/salma/:path*",
        "destination": "/:path",
        "type": 301
      },
      {
        "regex": "^/(?i:admin)(?:/|\\.html)?$",
        "destination": "/admin",
        "type": 301
      },
      {
        "source": "/editor",
        "destination": "/admin",
        "type": 301
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8085
    },
    "ui": {
      "enabled": false
    }
  }
}
